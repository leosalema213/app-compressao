{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LpsToolkit",
  "version": "0.1.1",
  "identifier": "com.lpstoolkit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LpsToolkit",
        "width": 800,
        "height": 600,
        "minWidth": 360,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNjI0REEyRTI4RDNGQ0UKUldUT1A0M2lvazFpNGZHRzJOZ3J0UTRINW16RGNyNTZNOGpha1NndU1aQXBwYy8vTEZIMURNU0IK",
      "endpoints": ["https://github.com/leosalema213/app-compressao/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
